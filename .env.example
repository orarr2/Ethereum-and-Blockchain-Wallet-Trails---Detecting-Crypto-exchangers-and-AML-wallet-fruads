# =============================================================================
#  Crypto-AML pipeline — environment configuration
#
#  Copy this file to .env and fill in your own values. .env is git-ignored.
#  NEVER commit credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — your Google Cloud project (billable; BigQuery API enabled)
# -----------------------------------------------------------------------------
# Find with:  gcloud projects list  (use the PROJECT_ID column)
BQ_PROJECT=

# -----------------------------------------------------------------------------
# AUTHENTICATION — pick ONE of these two paths
# -----------------------------------------------------------------------------
# Path A — short-lived access token (simple, ~1h expiry, no setup):
#   gcloud auth login
#   gcloud auth print-access-token
# Paste the result here.
BQ_ACCESS_TOKEN=

# Path B — Application Default Credentials (persistent, recommended for repeated runs):
# Leave BQ_ACCESS_TOKEN blank above and run once:
#   gcloud auth application-default login
# Then ADC will be picked up automatically.

# -----------------------------------------------------------------------------
# Optional — query cost ceilings & lookback windows
# -----------------------------------------------------------------------------
BQ_MAX_GB=150
LOOKBACK_DAYS=90
TRON_LOOKBACK_DAYS=7

# -----------------------------------------------------------------------------
# Optional — block-explorer enrichment
# -----------------------------------------------------------------------------
# Get a free Etherscan API key at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# -----------------------------------------------------------------------------
# Optional — public Ethereum RPC endpoints for ENS reverse-resolution
# (the script tries them in order until one connects)
# -----------------------------------------------------------------------------
ETH_RPC_URLS=https://ethereum-rpc.publicnode.com,https://cloudflare-eth.com,https://rpc.ankr.com/eth,https://eth.merkle.io,https://1rpc.io/eth
